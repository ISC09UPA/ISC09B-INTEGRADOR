[Unit]
Description=Gateway del Alimentador Inteligente (MQTT <-> backend)
Documentation=file:///opt/alimentador-gateway/README.md
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=alimentador
Group=alimentador
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/alimentador-gateway/venv/bin/alimentador-gateway --config /etc/alimentador/config.toml --check
ExecStart=/opt/alimentador-gateway/venv/bin/alimentador-gateway --config /etc/alimentador/config.toml
Restart=always
RestartSec=5
TimeoutStopSec=15

# /var/lib/alimentador (cola SQLite, artefactos OTA, fotos en espera)
StateDirectory=alimentador
StateDirectoryMode=0750

# Endurecimiento
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
